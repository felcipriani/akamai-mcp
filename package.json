{
  "name": "akamai-mcp",
  "version": "1.0.0",
  "description": "Read-only Akamai MCP server for CDN, application security and WAF investigations",
  "type": "module",
  "license": "MIT",
  "bin": {
    "akamai-mcp": "dist/index.js"
  },
  "files": ["dist", "docs/*.md", ".env.example"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felcipriani/akamai-mcp.git"
  },
  "homepage": "https://github.com/felcipriani/akamai-mcp#readme",
  "bugs": {
    "url": "https://github.com/felcipriani/akamai-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:source": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test scripts",
    "test": "npm run build && node --import tsx --test --test-reporter=tap test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke:akamai": "node --use-env-proxy scripts/akamai-smoke.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
